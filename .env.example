# Proveedor: deepseek (por defecto) o claude
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# URL pública base (para devolver links absolutos). Ej: https://landings.tudominio.com
PUBLIC_URL=http://localhost:8000

# Opcional: webhook de n8n que recibe cada lead capturado (demo 2)
N8N_WEBHOOK_URL=

# En Easypanel
DATA_DIR=/data
# Clave para el panel (usuario: cualquiera, contraseña: esta). Vacio = sin clave
APP_PASSWORD=pon-una-clave

# Medicion opcional: se inyecta en todas las landings y dispara el evento Lead / generate_lead
META_PIXEL_ID=
GA4_ID=

# ManyChat: etiqueta al suscriptor en cada hito del embudo (Settings > API)
MANYCHAT_API_KEY=

# n8n: API para desplegar el workflow (automations/deploy_n8n.py) y clave con la que n8n consulta a la app
N8N_API_URL=https://tu-n8n.com
N8N_API_KEY=
AUTOMATION_KEY=
# Duracion de un "dia" en las secuencias de email: 86400 en produccion, 60 para una demo en vivo
EMAIL_DAY_SECONDS=86400

# Stripe (opcional): con el secreto del webhook, las compras por Payment Link las confirma Stripe.
# Endpoint en Stripe > Developers > Webhooks: https://TU-DOMINIO/api/webhooks/stripe (evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Hotmart (opcional): con el hottok, las compras por link de Hotmart las confirma Hotmart (y los reembolsos cortan el acceso).
# Webhook 2.0 en Hotmart > Herramientas > Webhook: https://TU-DOMINIO/api/webhooks/hotmart (compra aprobada/completa, reembolso, contracargo, cancelacion)
HOTMART_HOTTOK=
